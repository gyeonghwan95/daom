    "audit:target-query-cannibalization": "npx --yes tsx scripts/audit-target-query-cannibalization.ts",
    "seo:regression:snapshot": "node scripts/seo-regression-guard.mjs --snapshot-before --snapshot-after --write-after",
    "seo:keyword-gap": "node scripts/seo-keyword-gap.mjs",
    "seo:local-intent-gap": "node scripts/seo-local-intent-gap.mjs",
    "seo:audit:new-similarity": "node scripts/audit-new-content-similarity.mjs",
