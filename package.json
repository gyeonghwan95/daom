    "seo:audit": "npx --yes tsx scripts/seo-high-competition-audit.ts",
    "seo:audit:priority": "npx --yes tsx scripts/audit-target-query-pages.ts && npx --yes tsx scripts/audit-seo-cannibalization.ts && npx --yes tsx scripts/audit-title-patterns.ts && npx --yes tsx scripts/audit-meta-descriptions.ts && npx --yes tsx scripts/audit-faq-duplicates.ts && npx --yes tsx scripts/audit-internal-link-authority.ts && npx --yes tsx scripts/audit-indexability.ts",
