    "seo:audit:local-similarity": "npx --yes tsx scripts/audit-local-content-similarity.ts",
    "seo:audit:public-sector-similarity": "npx --yes tsx scripts/audit-public-sector-content-similarity.ts",
    "seo:audit:lecture-similarity": "npx --yes tsx scripts/audit-lecture-content-similarity.ts",
    "seo:audit:corporate-legal-scope": "npx --yes tsx scripts/audit-corporate-scope-language.ts",
    "seo:audit:corporate-legal-similarity": "npx --yes tsx scripts/audit-corporate-legal-similarity.ts",
    "seo:audit:busan": "npx --yes tsx scripts/audit-busan-law-scrivener.ts && npx --yes tsx scripts/audit-query-champion-ownership.ts",
    "seo:snapshot:busan-lawyer": "node scripts/snapshot-busan-law-scrivener.mjs --before",
    "seo:inventory:lectures": "npx --yes tsx scripts/build-lecture-page-inventory.ts",
    "seo:audit:search-cannibalization": "npx --yes tsx scripts/audit-search-cannibalization.ts",
    "verify": "npm run build && npm run check:diagnosis",
    "preview": "npx --yes serve@14 out -p 3000",
    "preview:cf": "npx --yes wrangler@4 pages dev out --port 8788",
    "audit:page-images": "npx --yes tsx scripts/generate-page-image-inventory.ts && npx --yes tsx scripts/audit-page-images.ts",
    "check:og-images": "npx --yes tsx scripts/check-og-images.ts",
    "check:carousel-images": "npx --yes tsx scripts/check-carousel-images.ts",
    "generate:carousel-images": "npx --yes tsx scripts/generate-carousel-images.ts",
    "audit:attorney-photos": "npx --yes tsx scripts/audit-attorney-photos.ts",
    "check:profession-misrepresentation": "npx --yes tsx scripts/check-profession-misrepresentation.ts",
    "test:quick-inquiry": "npx --yes tsx scripts/test-quick-inquiry.mjs",
    "test:admin-url": "npx --yes tsx scripts/test-admin-url-display.ts",
    "test:admin-analytics": "npx --yes tsx scripts/test-admin-analytics-ingest.ts",
    "test:notice-dismiss": "npx --yes tsx scripts/test-notice-dismiss.ts",
    "bid:run": "npx --yes tsx collector/main.ts",
    "bid:dry": "npx --yes tsx collector/main.ts --dry-run",
    "bid:sample": "npx --yes tsx collector/main.ts --dry-run --fixture collector/tests/fixtures/g2b-servc-sample.json",
    "bid:sample:nuri": "npx --yes tsx collector/main.ts --dry-run --fixture collector/tests/fixtures/nuri-servc-sample.json",
    "bid:test": "npx --yes tsx collector/tests/run-tests.ts"
