# env files (can opt-in for committing if needed)
.env*
!.env.example

# vercel
.vercel

# typescript
*.tsbuildinfo
next-env.d.ts

# bid monitor (상태 DB·브리핑 출력물은 커밋하지 않음)
/collector/data/
/collector/output/
