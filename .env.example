# 사이트 기본 URL (SEO canonical, Open Graph, sitemap, RSS 등)
# 한글 도메인을 넣어도 빌드 시 punycode(xn--...)로 정규화되어
# sitemap <loc>과 페이지 canonical 호스트가 일치합니다. 페이지 path는 변경되지 않습니다.
NEXT_PUBLIC_SITE_URL=https://다옴법무사사무소.kr

# ── 검색엔진 소유권 확인 (선택) ──
# Google Search Console → HTML 태그 값
GOOGLE_SITE_VERIFICATION=
# Naver Search Advisor → 소유확인 meta content 값
NAVER_SITE_VERIFICATION=

# 상담 연락처 (미설정 시 아래 기본값 사용)
# NEXT_PUBLIC_PHONE=070-4172-8056
# NEXT_PUBLIC_KAKAO_CHANNEL=http://pf.kakao.com/_Bvhxnn/chat
# NEXT_PUBLIC_NAVER_TALK=https://talk.naver.com/ct/w661kd4
# NEXT_PUBLIC_NAVER_BLOG=https://blog.naver.com/law-yoon-91
NEXT_PUBLIC_PHONE=
NEXT_PUBLIC_KAKAO_CHANNEL=
NEXT_PUBLIC_NAVER_TALK=
NEXT_PUBLIC_NAVER_BLOG=
# 하위 호환 (NAVER_TALK 미설정 시 사용)
NEXT_PUBLIC_NAVER_BOOKING=
# 네이버 플레이스 ID (고객후기 수집 — 기본 2035745096)
NEXT_PUBLIC_NAVER_PLACE_ID=
# 오시는 길·플레이스 열기 단축 URL (기본 https://naver.me/58j9SzPA)
# NEXT_PUBLIC_NAVER_PLACE_URL=https://naver.me/58j9SzPA

# 공식 이메일 (기본: lawyoonjung@naver.com)
# NEXT_PUBLIC_CONTACT_EMAIL=lawyoonjung@naver.com
NEXT_PUBLIC_CONTACT_EMAIL=

# 사업자등록번호 (푸터·E-E-A-T 노출)
# NEXT_PUBLIC_BUSINESS_REGISTRATION_NUMBER=657-51-00996
NEXT_PUBLIC_BUSINESS_REGISTRATION_NUMBER=

# 온라인 문의 양식 (외부 링크 — 사이트에 개인정보 저장 안 함)
# Google Forms, Tally, 네이버폼 URL 중 하나 이상 설정
NEXT_PUBLIC_INQUIRY_FORM_GOOGLE=
NEXT_PUBLIC_INQUIRY_FORM_TALLY=
NEXT_PUBLIC_INQUIRY_FORM_NAVER=
# 기본으로 열 문의 양식: google | tally | naver (미설정 시 첫 번째 항목)
NEXT_PUBLIC_INQUIRY_FORM_PRIMARY=google
# 하위 호환용 단일 URL (위 항목이 없을 때만 사용)
NEXT_PUBLIC_INQUIRY_FORM_URL=

# ── 간편 문의 (Quick Inquiry) ──
# Cloudflare Pages Functions: /api/quick-inquiry
# 클라이언트에 노출되는 키는 SITE_KEY만. BOT_TOKEN·SECRET은 서버(환경변수) 전용.
NEXT_PUBLIC_TURNSTILE_SITE_KEY=
TURNSTILE_SECRET_KEY=
TELEGRAM_BOT_TOKEN=
TELEGRAM_CHAT_ID=
# 선택: Resend 이메일 백업 알림
RESEND_API_KEY=
INQUIRY_FROM_EMAIL=
INQUIRY_TO_EMAIL=
# 선택: 쉼표 구분 Origin 화이트리스트 (기본에 공식 도메인·localhost 포함)
ALLOWED_ORIGINS=

# ── 관리자 (Node 서버 배포 시, npm run build + next start) ──
# 12자 이상 비밀번호, 32자 이상 랜덤 시크릿 (openssl rand -base64 32)
ADMIN_PASSWORD=
ADMIN_SESSION_SECRET=

# ── 법무사 업무기회 데일리 브리핑 (collector/) ──
# 공공데이터포털 → "조달청_나라장터 입찰공고정보서비스" + "조달청_누리장터 민간입찰공고서비스" 각각 활용신청 → Decoding 인증키
G2B_SERVICE_KEY=
# 브리핑 이메일 (Resend — 위 RESEND_API_KEY 재사용)
# 미설정 시 INQUIRY_FROM_EMAIL / INQUIRY_TO_EMAIL을 대신 사용
BID_EMAIL_FROM=
BID_EMAIL_TO=
# 수집 조회 기간 (일, 기본 3 — 정정공고 추적용 여유 포함)
BID_LOOKBACK_DAYS=
# true면 주말 미발송
BID_WEEKDAYS_ONLY=
# 나라장터 API base 오버라이드 (엔드포인트 이관 대비, 기본값 사용 권장)
G2B_API_BASE=
# 상태 파일 경로 오버라이드 (기본 collector/data/state.json)
BID_STATE_PATH=

# ── 지도 (오시는 길 페이지) ──
# Kakao Developers → 앱 → 플랫폼 키 → JavaScript 키 → 「JavaScript SDK 도메인」
# (제품 링크 관리의 「웹 도메인」과 다릅니다)
# 예: http://localhost:3000 / https://xn--2j1br1na42lvxja38mk8r.kr
# 키 추가 후 반드시 npm run dev 재시작. 미설정 시 OpenStreetMap 폴백.
NEXT_PUBLIC_KAKAO_MAP_APP_KEY=
